{
  "name": "@shey/opencode-antigravity-agent",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that adds Antigravity Agent: Google Antigravity CLI (agy) as a model provider, with OpenCode keeping its own tools, permissions, and history.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    }
  },
  "peerDependencies": {
    "@opencode/ai": ">=2.4.1",
    "@opencode/plugin": ">=2.2.5",
    "effect": ">=4.1.0"
  }
}
